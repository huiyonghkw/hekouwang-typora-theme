{
  "_meta": {
    "name": "hekouwang",
    "slug": "hekouwang",
    "desc": "Typora 主题 · 复刻 Claude 桌面端阅读体验",
    "note": "单一真相源。改视觉只改这里，跑 build.py 重新生成 CSS。",
    "preset": "claude-read"
  },
  "_presets": {
    "_note": "当前 = 对齐 Claude 桌面端 prose（采样自 Claude.app epitaxy-markdown / file-prose）。work 值留给确认后的紧凑模式。",
    "claude_ref": {
      "chat_body": "14px",
      "chat_leading": "1.42857",
      "file_prose_h1": "22px/28px",
      "file_prose_h2": "17px/22px",
      "file_prose_gap": "16px",
      "list_pad": "20px",
      "list_item_gap": "6px",
      "measure": "65ch"
    },
    "work": {
      "measure": "46rem",
      "body_size": "1rem",
      "body_lh": "1.62",
      "para_gap": "0.78rem",
      "block_gap": "0.9rem",
      "rule_gap": "1.5rem",
      "list_gap": "0.22rem",
      "fences_lh": "1.62",
      "write_pad_top": "1.8rem",
      "write_pad_bottom": "4rem",
      "write_pad_x": "1rem"
    }
  },
  "color": {
    "_note": "实测采样自 Claude Code 桌面端：对话区 #fdfdfc（近纯白），#faf9f5 是窗口底色。行内代码走暖褐 #8a5a3c + 品牌色浅底：纯红太吵、纯中性又辨识不出，折中点是「低饱和暖色 + 有存在感的底」，且底色用品牌橙而非墨色，跟骨白暖调同系。border/divider 一律用 ink 的 alpha 叠加，避免灰死色。",
    "bg": "#fdfdfc",
    "bg_raised": "#ffffff",
    "sidebar_bg": "#f5f4ed",
    "hover": "#f0eee6",
    "sunken": "#f5f4ed",
    "ink": "#1f1e1d",
    "text": "#141413",
    "text_soft": "#3d3d3a",
    "text_muted": "#73726c",
    "text_faint": "#a3a29b",
    "accent": "#d97757",
    "accent_deep": "#b45f51",
    "code_text": "#8a5a3c",
    "link": "#c05d3c",
    "border_base": "#1f1e1d",
    "shadow_base": "#1f1e1d",
    "code_bg_base": "#d97757",
    "code_bg_alpha": "0.11"
  },
  "alpha": {
    "_note": "统一的透明度阶，供边框/分隔线/底纹取用",
    "hairline": "0.10",
    "line": "0.14",
    "divider": "0.20",
    "strong": "0.42"
  },
  "type": {
    "_note": "对齐 Claude.app CDS/chat：默认 body 14px、leading 20px（比值 1.42857）、measure 65ch。Typora 根字号仍用 16px（偏好调节），正文 0.875rem = 14px。",
    "root_px": "16px",
    "measure": "65ch",
    "body_size": "0.875rem",
    "body_lh": "1.42857",
    "body_align": "left",
    "para_indent": "0",
    "_reading_note": "Claude 对话默认左齐。字号偏小可在 Typora 偏好里调大，或把 body_size 改为 1rem（≈Claude text-size=L）。",
    "para_gap": "0.625rem",
    "_gap_note": "段距≈chat-item-gap 10px；块距≈file-prose 16px；列表项距≈--p5 6px。",
    "block_gap": "1rem",
    "rule_gap": "1.5rem",
    "list_gap": "0.375rem",
    "cell_pad": "0.4rem 0.7rem",
    "h1": {
