  "font": {
    "_note": "对齐 Claude --font-anthropic-sans：家族名 Anthropic Sans（nameID 16），CJK 仍走系统。Hekouwang Sans 用 @font-face 挂 local()+fonts-local；无 Claude 字体时落到 Inter OFL。栈序：西文在前、中文在后。Windows 由 body.os-windows 单独接管，避免系统 UI 回退次序随版本漂移。",
    "sans_stack": "\"Hekouwang Sans\", \"Anthropic Sans\", \"Hekouwang Sans Fb\", system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei\", sans-serif",
    "serif_stack": "\"Hekouwang Serif\", \"Anthropic Serif\", Georgia, \"Times New Roman\", \"Songti SC\", serif",
    "mono_stack": "\"Hekouwang Mono\", \"Anthropic Mono\", \"SF Mono\", ui-monospace, Menlo, Consolas, monospace",
    "windows_sans_stack": "\"Hekouwang Sans\", \"Anthropic Sans\", \"Hekouwang Sans Fb\", \"Segoe UI Variable Text\", \"Segoe UI\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", Arial, sans-serif",
    "windows_serif_stack": "\"Hekouwang Serif\", \"Anthropic Serif\", Georgia, \"Times New Roman\", \"SimSun\", serif",
    "windows_mono_stack": "\"Hekouwang Mono\", \"Anthropic Mono\", \"Cascadia Mono\", \"Cascadia Code\", Consolas, \"Lucida Console\", monospace"
  },
  "shape": {
    "_note": "付费档默认圆角。免费 V2 在 palettes.json 里把三档覆盖为 0（直角），只保留滚动条等控件的 pill。",
    "radius_sm": "6px",
    "radius": "10px",
    "radius_lg": "14px",
    "radius_pill": "999px"
  },
  "layout": {
    "_note": "默认 = work 阅读边距。measure_gutter = 栏宽流体两侧预留；wide_breakpoint / wide_measure 控制宽窗口扩展；wide_canvas_extra = 宽窗口纸面比阅读列多出的技术画布（两侧合计）。",
    "write_margin_top": "1rem",
    "write_pad_top": "2.25rem",
    "write_pad_bottom": "5rem",
    "write_pad_x": "2rem",
    "measure_gutter": "4rem",
    "wide_breakpoint": "1440px",
    "wide_measure": "120em",
    "wide_canvas_extra": "6rem"
  },
  "paper": {
    "_note": "V2 白纸：纸面纯白，纸边只深一档并带一点暖调（#fbfbf8）；壳层 #f8f8f5。导出整页 = 纸面色，白纸即白。",
    "enabled": true,
    "highlight": "#ffffff",
    "mid": "#ffffff",
    "shade": "#fbfbf8",
    "gutter": "#f8f8f5",
    "grain_opacity": "0",
    "inset_alpha": "0.04",
    "dark": {
      "_note": "深色纸面冷灰黑，外框/侧栏比纸面更暗，纸边只深半档。",
      "enabled": true,
      "highlight": "#1f242b",
      "mid": "#161b22",
      "shade": "#10141a",
      "gutter": "#0d1117",
      "grain_opacity": "0",
      "inset_alpha": "0.14"
    }
  },
  "dark": {
    "_note": "墨玉深色：纸面去蓝调、带一点绿黑，壳层更暗；灰阶四级（ink/text/soft/muted/faint）各自拉开，soft 不再与 muted 重合。强调绿降饱和到 #74b7a2，只在 hover 提亮。正文 #c2c8c2 控制在 10:1 左右，长读不刺眼。",
    "color": {
      "bg": "#151816",
      "bg_raised": "#1b1f1c",
      "sidebar_bg": "#0c0e0d",
      "hover": "#1e221e",
      "sunken": "#101311",
      "ink": "#eef2ee",
      "text": "#c2c8c2",
      "text_soft": "#a9b1ab",
      "text_muted": "#9aa39c",
      "text_faint": "#878f88",
      "control_border": "#7f8781",
      "accent": "#74b7a2",
      "accent_deep": "#9ad2bd",
      "code_text": "#c2c8c2",
      "link": "#86c7b2",
      "border_base": "#ffffff",
      "shadow_base": "#000000",
      "code_bg_base": "#ffffff",
      "code_bg_alpha": "0.06"
    },
    "alpha": {
      "_note": "深色下白色叠加的可见度比墨色叠加低，各档要略微加大",
      "hairline": "0.09",
      "line": "0.13",
      "divider": "0.20",
      "strong": "0.40"
    }
  }
