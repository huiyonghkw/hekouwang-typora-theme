{
  "_meta": {
    "name": "hekouwang",
    "slug": "hekouwang",
    "desc": "Typora 主题 · 中文长文阅读（浅色 + 深色）",
    "note": "单一真相源。改视觉只改这里，跑 build.py 生成 hekouwang.css / hekouwang-dark.css。",
    "preset": "work",
    "presets_built": ["work"]
  },
  "_presets": {
    "_note": "build.py 按本表生成 CSS。目前只构建 work（中文长文主场）。",
    "work": {
      "_note": "中文长文默认。行高≥1.6、栏宽 min(52em,100%-gutter) 随窗伸缩、正文 16px。浅色纸感画在 #write。",
      "slug_suffix": "",
      "label": "CJK long-form (default)",
      "type": {
        "root_px": "16px",
        "measure": "52em",
        "body_size": "1rem",
        "body_lh": "1.65",
        "body_align": "left",
        "para_indent": "0",
        "para_gap": "0.78rem",
        "block_gap": "1.1rem",
        "rule_gap": "1.75rem",
        "list_gap": "0.2rem",
        "cell_pad": "0.68rem 0.85rem",
        "h1": {
          "size": "1.75rem",
          "lh": "1.25",
          "weight": "600",
          "mt": "2rem",
          "mb": "1rem",
          "ls": "-0.014em"
        },
        "h2": {
          "size": "1.35rem",
          "lh": "1.28",
          "weight": "600",
          "mt": "2.15rem",
          "mb": "0.92rem",
          "ls": "-0.012em"
        },
        "h3": {
          "size": "1.0625rem",
          "lh": "1.35",
          "weight": "600",
          "mt": "1.4rem",
          "mb": "0.45rem",
          "ls": "-0.006em"
        },
        "h4": {
          "size": "1rem",
          "lh": "1.4",
          "weight": "600",
          "mt": "1.15rem",
          "mb": "0.35rem",
          "ls": "0"
        },
        "h5": {
          "size": "0.9375rem",
          "lh": "1.45",
          "weight": "600",
          "mt": "1rem",
          "mb": "0.3rem",
          "ls": "0"
        },
        "h6": {
          "size": "0.875rem",
          "lh": "1.45",
          "weight": "600",
          "mt": "0.9rem",
          "mb": "0.28rem",
          "ls": "0"
        },
        "small": "0.8125rem",
        "code_size": "0.9em",
        "fences_size": "0.875rem",
        "fences_lh": "1.65"
      },
      "layout": {
        "write_pad_top": "2.25rem",
        "write_pad_bottom": "5rem",
        "write_pad_x": "2rem",
        "measure_gutter": "4rem"
      },
      "paper": {
        "enabled": true
      }
    }
  },
  "color": {
    "_note": "实测采样自 Claude Code 桌面端：对话区 #fdfdfc（近纯白），#faf9f5 是窗口底色。行内代码走暖褐 #8a5a3c + 品牌色浅底：纯红太吵、纯中性又辨识不出，折中点是「低饱和暖色 + 有存在感的底」，且底色用品牌橙而非墨色，跟骨白暖调同系。border/divider 一律用 ink 的 alpha 叠加，避免灰死色。",
    "bg": "#fdfdfc",
    "bg_raised": "#ffffff",
    "sidebar_bg": "#ebe8df",
    "hover": "#e2dfd6",
    "sunken": "#f5f4ed",
    "ink": "#141413",
    "text": "#141413",
    "text_soft": "#3d3d3a",
    "text_muted": "#73726c",
    "text_faint": "#a3a29b",
    "accent": "#d97757",
    "accent_deep": "#b45f51",
    "code_text": "#8a5a3c",
    "link": "#c05d3c",
    "border_base": "#1f1e1d",
    "shadow_base": "#1f1e1d",
    "code_bg_base": "#d97757",
    "code_bg_alpha": "0.11"
  },
  "alpha": {
    "_note": "统一的透明度阶，供边框/分隔线/底纹取用",
    "hairline": "0.10",
    "line": "0.14",
    "divider": "0.20",
    "strong": "0.42"
  },
  "type": {
    "_note": "默认 = work（中文长文）。完整两套在 _presets；改默认档请改 _meta.preset 并同步本节与 _presets.work。",
    "root_px": "16px",
    "measure": "52em",
    "body_size": "1rem",
    "body_lh": "1.65",
    "body_align": "left",
    "para_indent": "0",
    "_reading_note": "CJK 长文：行高 1.65、栏宽 min(52em, 100%-gutter) 随窗伸缩、正文 1rem。表多文档吃宽上限；纯散文仍可读。",
    "para_gap": "0.78rem",
    "block_gap": "1.1rem",
    "rule_gap": "1.75rem",
    "list_gap": "0.2rem",
    "cell_pad": "0.68rem 0.85rem",
    "h1": {
      "size": "1.75rem",
      "lh": "1.25",
      "weight": "600",
      "mt": "2rem",
      "mb": "1rem",
      "ls": "-0.014em"
    },
    "h2": {
      "size": "1.35rem",
      "lh": "1.28",
      "weight": "600",
      "mt": "2.15rem",
      "mb": "0.92rem",
      "ls": "-0.012em"
    },
    "h3": {
      "size": "1.0625rem",
      "lh": "1.35",
      "weight": "600",
      "mt": "1.4rem",
      "mb": "0.45rem",
      "ls": "-0.006em"
    },
    "h4": {
      "size": "1rem",
      "lh": "1.4",
      "weight": "600",
      "mt": "1.15rem",
      "mb": "0.35rem",
      "ls": "0"
    },
    "h5": {
      "size": "0.9375rem",
