      "layout": {
        "write_margin_top": "1rem",
        "write_pad_top": "2.25rem",
        "write_pad_bottom": "5rem",
        "write_pad_x": "2rem",
        "measure_gutter": "4rem",
        "wide_breakpoint": "1440px",
        "wide_measure": "120em",
        "wide_canvas_extra": "6rem"
      },
      "paper": {
        "enabled": true
      }
    }
  },
  "color": {
    "_note": "免费 V2 的实测色板：纸面 #ffffff、正文 #37413c、标题 #141a17、弱化 #59635d；行内代码底与边框由 ink 叠透明度派生，代码块 #f7f8f3；强调绿 #2e6f5e 只给链接、按钮和激活态。中性色统一带一点绿色墨调，与强调色同族。",
    "bg": "#ffffff",
    "bg_raised": "#ffffff",
    "sidebar_bg": "#fafaf7",
    "hover": "#f2f3ef",
    "sunken": "#f7f8f3",
    "ink": "#141a17",
    "text": "#37413c",
    "text_soft": "#4c554f",
    "text_muted": "#59635d",
    "text_faint": "#636e68",
    "control_border": "#858d87",
