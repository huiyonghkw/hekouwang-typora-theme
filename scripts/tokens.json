  "font": {
    "_note": "对齐 Claude --font-anthropic-sans：家族名 Anthropic Sans（nameID 16），CJK 仍走系统。Hekouwang Sans 用 @font-face 挂 local()+fonts-local；无 Claude 字体时落到 Inter OFL。栈序：西文在前、中文在后。",
    "sans_stack": "\"Hekouwang Sans\", \"Anthropic Sans\", \"Hekouwang Sans Fb\", system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei\", sans-serif",
    "serif_stack": "\"Hekouwang Serif\", \"Anthropic Serif\", Georgia, \"Times New Roman\", \"Songti SC\", serif",
    "mono_stack": "\"Hekouwang Mono\", \"Anthropic Mono\", \"SF Mono\", ui-monospace, Menlo, Consolas, monospace"
  },
  "shape": {
    "radius_sm": "6px",
    "radius": "10px",
    "radius_lg": "14px",
    "radius_pill": "999px"
  },
  "layout": {
    "_note": "对话栏式页边：左右充裕、上下留白，接近 Claude 主栏呼吸感。",
    "write_pad_top": "2rem",
    "write_pad_bottom": "4.5rem",
    "write_pad_x": "1.5rem"
  },
  "dark": {
    "_note": "全部采样自 Claude Code 深色模式截图，不是把浅色版取反。⚠️ 最反直觉的一条：深色下侧边栏 #262626 比正文区 #1f1f1e 更亮，与浅色模式的明暗关系正好相反 —— 靠推演一定会做反。行内代码底实测为中性白叠加(三通道解出 alpha 0.036/0.040/0.031 一致)，而非品牌橙叠加(解出 0.043/0.10/0.12 不一致)，所以深色不沿用浅色的橙底。",
    "color": {
      "bg": "#1f1f1e",
      "bg_raised": "#262626",
      "sidebar_bg": "#262626",
      "hover": "#2c2c2a",
      "sunken": "#1a1a19",
      "ink": "#ffffff",
      "text": "#ffffff",
      "text_soft": "#dad9cc",
      "text_muted": "#a8a79b",
      "text_faint": "#75746a",
      "accent": "#d97757",
      "accent_deep": "#e0917a",
      "code_text": "#ffb0af",
      "link": "#e79a80",
      "border_base": "#ffffff",
      "shadow_base": "#000000",
      "code_bg_base": "#ffffff",
      "code_bg_alpha": "0.055"
    },
    "alpha": {
      "_note": "深色下白色叠加的可见度比墨色叠加低，各档要略微加大",
      "hairline": "0.09",
      "line": "0.13",
      "divider": "0.20",
      "strong": "0.40"
    }
