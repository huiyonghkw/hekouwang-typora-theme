{
  "_meta": {
    "name": "hekouwang",
    "slug": "hekouwang",
    "desc": "Typora 主题 · 中文长文阅读（浅色 + 深色）",
    "note": "单一真相源。改视觉只改这里，跑 build.py 生成 hekouwang.css / hekouwang-dark.css。",
    "preset": "work",
    "presets_built": [
      "work"
    ]
  },
  "_presets": {
    "_note": "build.py 按本表生成 CSS。目前只构建 work（中文长文主场）。",
    "work": {
      "_note": "中文长文默认。纸面随窗口伸缩，两侧各留约 3rem；正文阅读列 = 窗口宽度 − 16rem，介于 48rem 与 96rem 之间。浅色纸感画在 #write。",
      "slug_suffix": "",
      "label": "CJK long-form (default)",
      "type": {
        "root_px": "16px",
        "measure": "120em",
        "reading_measure": "clamp(48rem, calc(100vw - 16rem), 96rem)",
        "body_size": "1rem",
        "body_lh": "1.65",
        "body_align": "left",
        "para_indent": "0",
        "para_gap": "0.85rem",
        "block_gap": "1.1rem",
        "rule_gap": "1.75rem",
        "list_gap": "0.26rem",
        "cell_pad": "0.68rem 0.85rem",
        "h1": {
          "size": "2.125rem",
          "lh": "1.2",
          "weight": "700",
          "mt": "2rem",
          "mb": "1rem",
          "ls": "-0.025em"
        },
        "h2": {
          "size": "1.5rem",
          "lh": "1.3",
          "weight": "700",
          "mt": "2.15rem",
          "mb": "0.85rem",
          "ls": "-0.02em"
        },
        "h3": {
          "size": "1.25rem",
          "lh": "1.35",
          "weight": "650",
          "mt": "1.4rem",
          "mb": "0.5rem",
          "ls": "-0.01em"
        },
        "h4": {
          "size": "1.0625rem",
          "lh": "1.4",
          "weight": "700",
          "mt": "1.15rem",
          "mb": "0.35rem",
          "ls": "0"
        },
        "h5": {
          "size": "0.9375rem",
          "lh": "1.45",
          "weight": "650",
          "mt": "0.95rem",
          "mb": "0.28rem",
          "ls": "0"
        },
        "h6": {
          "size": "0.875rem",
          "lh": "1.45",
          "weight": "650",
          "mt": "0.9rem",
          "mb": "0.28rem",
          "ls": "0"
        },
        "small": "0.875rem",
        "table_size": "0.875rem",
        "code_size": "0.9em",
        "fences_size": "0.9375rem",
        "fences_lh": "1.55"
